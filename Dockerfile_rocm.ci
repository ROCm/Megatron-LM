ARG BASE_DOCKER=rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.9.1
FROM $BASE_DOCKER

ARG PYTORCH_ROCM_ARCH_OVERRIDE="gfx942"

ENV NO_PROXY=localhost,127.0.0.1,pypi.org,files.pythonhosted.org,raw.githubusercontent.com
ENV WORKSPACE_DIR=/workspace
ENV STAGE_DIR=/workspace/installs
ENV PIP_DEFAULT_TIMEOUT=120
ENV PIP_RETRIES=10
RUN mkdir -p $WORKSPACE_DIR
RUN mkdir -p ${STAGE_DIR}
WORKDIR $WORKSPACE_DIR

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        cmake autoconf automake libtool flex locales libibverbs-dev && \
    locale-gen en_US.UTF-8 && \
    rm -rf /var/lib/apt/lists/*

# Check python3 version and install respective python3-dev
RUN PY3_VER="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')" && \
    if apt-cache show "python${PY3_VER}-dev" >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends "python${PY3_VER}-dev"; \
        # Overwrite python3-config to point to the correct version to prevent mismatch during Megatron-DeepSpeed build
        ln -sf /usr/bin/python${PY3_VER}-config /usr/bin/python3-config; \
    else \
        apt-get install -y --no-install-recommends python3-dev; \
    fi

RUN pip3 install \
scipy \
wheel \
PyGithub \
pytest-xdist \
psutil \
transformers \
einops \
flask-restful \
pytest \
pytest-cov \
pytest_mock \
pytest-csv \
pytest-asyncio \
pytest-random-order \
sentencepiece \
wrapt \
zarr \
wandb \
tensorboard \
tensorstore==0.1.45 \
pytest_mock \
pybind11 \
setuptools==69.5.1 \
datasets \
tiktoken \
pynvml \
fastapi \
uvicorn \
msgpack

RUN pip install "nltk==3.8.1"

# Install Causal-Conv1d and its dependencies
WORKDIR ${STAGE_DIR}
ENV CAUSAL_CONV1D_FORCE_BUILD=TRUE
ENV MAMBA_FORCE_BUILD=TRUE
ENV HIP_ARCHITECTURES=${PYTORCH_ROCM_ARCH_OVERRIDE}
RUN git clone https://github.com/Dao-AILab/causal-conv1d causal-conv1d &&\
    cd causal-conv1d &&\
    git show --oneline -s &&\
    pip install --no-build-isolation .

# Install mamba
WORKDIR ${STAGE_DIR}
RUN pip install mamba-ssm --no-build-isolation

# Build flash-attention
ARG BUILD_FA="1"
ARG FA_BRANCH="main"
ARG FA_REPO="https://github.com/ROCm/flash-attention.git"
WORKDIR $WORKSPACE_DIR
RUN if [ "$BUILD_FA" -eq "1" ]; then \
git clone ${FA_REPO} \
&& cd flash-attention \
&& git checkout ${FA_BRANCH} \
&& MAX_JOBS=128 GPU_ARCHS=${PYTORCH_ROCM_ARCH_OVERRIDE} python3 setup.py install; \
fi

# Clone TE repo and submodules
WORKDIR ${STAGE_DIR}

ARG TE_COMMIT=release_v2.2_rocm
ENV NVTE_FRAMEWORK=pytorch
ENV PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH_OVERRIDE}
ENV NVTE_USE_HIPBLASLT=1
ENV NVTE_AITER_PREBUILT_BASE_URL=https://compute-artifactory.amd.com:5000/artifactory/rocm-generic-local/te-ci/aiter-prebuilts

RUN git clone --recursive https://github.com/ROCm/TransformerEngine.git && \
    cd TransformerEngine && \
    git checkout ${TE_COMMIT} && \
    git submodule update --init --recursive && \
    echo "TransformerEngine at commit:" $(git rev-parse HEAD) && \
    pip install --no-build-isolation .

RUN git clone https://github.com/caaatch22/grouped_gemm.git &&\
    cd grouped_gemm &&\
    git checkout rocm &&\
    git submodule update --init --recursive &&\
    pip install --no-build-isolation .


RUN git clone https://github.com/NVIDIA-NeMo/Emerging-Optimizers.git &&\
    cd Emerging-Optimizers &&\
    git checkout v0.1.0 &&\
    pip install --no-build-isolation .

# ── Build rocSHMEM ─────────────────────────────────────────────────
ARG ROCSHMEM_BACKEND=mlx5
WORKDIR ${STAGE_DIR}

RUN git clone https://github.com/ROCm/rocSHMEM.git

WORKDIR ${STAGE_DIR}/rocSHMEM/build
RUN if [ "${ROCSHMEM_BACKEND}" = "mlx5" ]; then \
        export CMAKE_PREFIX_PATH=/opt/rocm/lib/cmake/ && \
        ../scripts/build_configs/gda_mlx5 -DUSE_IPC=ON; \
    else \
        ../scripts/build_configs/ro_ipc; \
    fi

ENV BUILD_DIR=${STAGE_DIR}/dependencies
WORKDIR ${STAGE_DIR}/rocSHMEM
RUN bash scripts/install_dependencies.sh

ENV MPI_ROOT=${STAGE_DIR}/dependencies/install/ompi \
    OMPI_DIR=${STAGE_DIR}/dependencies/install/ompi
ENV PATH=${MPI_ROOT}/bin:${MPI_ROOT}/sbin:${PATH} \
    LD_LIBRARY_PATH=${MPI_ROOT}/lib:${LD_LIBRARY_PATH:-} \
    C_INCLUDE_PATH=${MPI_ROOT}/include:${C_INCLUDE_PATH:-} \
    CPLUS_INCLUDE_PATH=${MPI_ROOT}/include:${CPLUS_INCLUDE_PATH:-} \
    PKG_CONFIG_PATH=${MPI_ROOT}/lib/pkgconfig:${PKG_CONFIG_PATH:-} \
    MANPATH=${MPI_ROOT}/share/man:${MANPATH:-} \
    CMAKE_C_COMPILER=${MPI_ROOT}/bin/mpicc \
    CMAKE_CXX_COMPILER=${MPI_ROOT}/bin/mpicxx

# ── Build & install DeepEP ─────────────────────────────────────────
ARG DEEPEP_REPO=public
WORKDIR ${STAGE_DIR}
RUN if [ "${DEEPEP_REPO}" = "private" ]; then \
        git clone https://github.com/ROCm/deepEP_private.git && \
        cd deepEP_private && git checkout develop; \
    else \
        git clone https://github.com/ROCm/DeepEP.git && \
        cd DeepEP; \
    fi

RUN REPO_DIR=$([ "${DEEPEP_REPO}" = "private" ] && echo "deepEP_private" || echo "DeepEP") && \
    cd ${STAGE_DIR}/${REPO_DIR} && \
    ROCSHMEM_DIR=/root/rocshmem \
    OMPI_DIR=${STAGE_DIR}/dependencies/install/ompi \
    CFLAGS="-O3 -fPIC" \
    CXXFLAGS="-O3 -fPIC --offload-arch=${PYTORCH_ROCM_ARCH}" \
    HIP_CXX_FLAGS="-O3 -fPIC" \
    python setup.py --variant rocm build develop

WORKDIR $WORKSPACE_DIR
COPY . Megatron-LM
WORKDIR $WORKSPACE_DIR/Megatron-LM
RUN pip install -e .

ENV PYTHONPATH=/var/lib/jenkins/triton/python

# record configuration for posterity
RUN pip list
